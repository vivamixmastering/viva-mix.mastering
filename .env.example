# این فایل رو کپی کن و اسمش رو بذار .env
# بعد مقدارها رو پر کن

# توکن ربات — از @BotFather توی تلگرام بگیر
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij

# آیدی عددی ادمین (اختیاری) — فقط ادمین می‌تونه ربات رو با /on و /off خاموش/روشن کنه
# آیدیت رو از @userinfobot بگیر. اگه خالی بذاری همه می‌تونن خاموش/روشن کنن.
ADMIN_ID=0

# ── حالت هوشمند (جداسازی خودکار وکال با Demucs) ──
# برای فعال بودن دکمهٔ «✨ هوشمند» باید 1 باشه (کتابخانه‌ها در requirements.txt هستن)
SMART_MODE=1
# مدل جداسازی: mdx_extra_q (پیش‌فرض سبک) یا htdemucs (کیفیت بهتر، رم بیشتر)
DEMUCS_MODEL=mdx_extra_q
# طول تکهٔ پردازش جداسازی (ثانیه) — سرور با رم کم: 2-3
DEMUCS_CHUNK=3

# ── کلید روشن/خاموش واقعی سرویس ابری (/on و /off) ──
# Railway (پیشنهادی): توکن API از https://railway.com/account/tokens
# شناسه‌های RAILWAY_PROJECT_ID / ENVIRONMENT_ID / SERVICE_ID رو خود Railway
# توی کانتینر تزریق می‌کنه و لازم نیست دستی تنظیم بشن.
RAILWAY_API_TOKEN=

# Render (جایگزین): اگه روی Render دیپلوی می‌کنی این دو تا رو تنظیم کن
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
